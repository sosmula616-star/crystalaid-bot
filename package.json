{
  "name": "crystalaid",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm -r --if-present build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint . && node scripts/check-css-colors.mjs",
    "test": "vitest run",
    "db:migrate": "pnpm --dir packages/database run migrate"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "eslint": "^10.14.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  }
}
