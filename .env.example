# Read by the API and the worker at start: apps/api/src/main.ts loads this file from the repository
# root when it exists. Variables already set in the real environment win over the file.
# Secrets: at least 32 characters. Never commit the real .env.
DISCORD_CLIENT_ID=your-discord-client-id
DISCORD_CLIENT_SECRET=your-discord-client-secret
DISCORD_BOT_TOKEN=your-discord-bot-token
DISCORD_API_URL=https://discord.com/api/v10
# docker-compose.yml takes these two passwords from here; use the same values in the URLs below.
POSTGRES_PASSWORD=replace-with-a-database-password
REDIS_PASSWORD=replace-with-a-redis-password
DATABASE_URL=postgres://crystalaid:replace-with-a-database-password@localhost:5432/crystalaid
REDIS_URL=redis://:replace-with-a-redis-password@localhost:6379
JWT_SECRET=replace-with-at-least-32-characters-secret
SERVICE_TOKEN=replace-with-at-least-32-characters-token
# Base URL of the API for the bot (default: http://127.0.0.1:PORT).
# API_URL=
# Comma-separated IPs or CIDRs of reverse proxies whose X-Forwarded-For is trusted. Empty: trust none.
TRUSTED_PROXIES=
PORT=3001
# The only value the Activity (Vite) reads: the public Discord application id, same as DISCORD_CLIENT_ID.
# Only VITE_* names are exposed to the browser; never prefix a secret with VITE_.
VITE_DISCORD_CLIENT_ID=your-discord-client-id
TEST_DATABASE_URL=postgres://crystalaid:replace-with-a-database-password@localhost:5432/crystalaid_test
TEST_REDIS_URL=redis://:replace-with-a-redis-password@localhost:6379/1
# Optional: path to the server config file (default: crystalaid.config.json in the repo root)
# CONFIG_PATH=
# Dev only: `pnpm --dir apps/activity run dev:mock` runs the Activity with a fake Discord SDK and API
# (apps/activity/.env.mock sets this). URL: ?level=SUPPORT|CURATOR|ADMIN  ?name=long  ?error=NOT_STAFF
# ?pip=1|0 . The /kit showcase is available in dev without it. Neither reaches a production build.
# VITE_DEV_MOCK=1
