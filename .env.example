# Loaded from the repository root at start when the file exists; variables already set in the
# real environment win over the file. Never commit the real .env.
DISCORD_BOT_TOKEN=your-discord-bot-token
DISCORD_CLIENT_ID=your-discord-application-id
DATABASE_URL=postgres://user:password@localhost:5432/crystalaid_bot
# Optional. When unset, a local redis-server is started on 127.0.0.1 (it must be installed).
# REDIS_URL=redis://localhost:6379
# Optional: the port of GET /health (default 3000).
# PORT=3000
# Server config as one line of JSON; when unset, config.json in the repository root is read.
# See config.example.json for the shape.
# CONFIG_JSON={"guildId":"...","timezone":"Europe/Moscow","roles":{"support":["..."],"curator":["..."]},"users":{"admins":["..."],"developers":["..."]},"channels":{"log":"...","help":"..."}}

# Tests only (pnpm test): a separate database and Redis; never the production ones.
# TEST_DATABASE_URL=postgres://user:password@localhost:5432/crystalaid_bot_test
# TEST_REDIS_URL=redis://localhost:6379/1
